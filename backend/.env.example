APP_NAME=AlemEdu
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
DB_CONNECTION=sqlite
# Leave DB_DATABASE unset to use backend/database/database.sqlite.
DB_FOREIGN_KEYS=true
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
LOG_LEVEL=debug
DEMO_MODE=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# auto: OpenAI when a key is set, otherwise explicit local demo mode.
# Use openai to require a real connection, or mock for offline demos.
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
